POSTGRES_DB=insightflow
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=replace-with-a-strong-password
INSIGHTFLOW_API_PORT=8080
INSIGHTFLOW_SECURITY_JWT_ISSUER_URI=https://keycloak.example.com/realms/insightflow
INSIGHTFLOW_SECURITY_JWT_JWK_SET_URI=
INSIGHTFLOW_SECURITY_JWT_AUDIENCE=insightflow-api
INSIGHTFLOW_AI_PROVIDER=spring-ai
SPRING_AI_MODEL_CHAT=ollama
SPRING_AI_MODEL_EMBEDDING=ollama
SPRING_AI_OLLAMA_BASE_URL=http://ollama:11434
SPRING_AI_OLLAMA_CHAT_MODEL=llama3.1
SPRING_AI_OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
INSIGHTFLOW_RAG_EMBEDDINGS_PROVIDER=spring-ai
INSIGHTFLOW_RAG_EMBEDDINGS_MODEL=mxbai-embed-large
INSIGHTFLOW_RAG_EMBEDDINGS_DIMENSIONS=1024
OPENAI_API_KEY=
