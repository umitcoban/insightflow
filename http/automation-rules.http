@baseUrl = http://localhost:8080
@tenantSlug = acme
@accessToken = paste-access-token-here
@ruleId = replace-with-rule-id
@executionId = replace-with-execution-id

### Create tenant if needed
POST {{baseUrl}}/api/v1/tenants
Content-Type: application/json
Authorization: Bearer {{accessToken}}
X-Correlation-Id: demo-automation-create-tenant-001

{
  "slug": "{{tenantSlug}}",
  "name": "Acme Corporation"
}

### Create automation rule
POST {{baseUrl}}/api/v1/automation/rules
Content-Type: application/json
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-create-automation-rule-001

{
  "name": "Escalate high risk negative feedback",
  "description": "Create an internal action when feedback is negative and high risk.",
  "triggerEventType": "feedback.ai-analysis-completed",
  "conditionJson": {
    "sentiment": "NEGATIVE",
    "riskLevel": "CHURN_RISK",
    "priority": ["HIGH", "CRITICAL"]
  },
  "actionJson": [
    {
      "type": "LOG",
      "message": "High risk negative feedback detected"
    }
  ],
  "priority": 100
}

### Create automation rule for AI completed event
POST {{baseUrl}}/api/v1/automation/rules
Content-Type: application/json
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-create-automation-rule-ai-completed-001

{
  "name": "Log churn risk negative feedback",
  "description": "Logs feedbacks that AI marks as churn risk.",
  "triggerEventType": "feedback.ai-analysis-completed",
  "conditionJson": {
    "sentiment": "NEGATIVE",
    "riskLevel": "CHURN_RISK"
  },
  "actionJson": [
    {
      "type": "LOG",
      "message": "Churn risk negative feedback detected"
    }
  ],
  "priority": 100
}

### Create automation rule with WEBHOOK action
POST {{baseUrl}}/api/v1/automation/rules
Content-Type: application/json
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-create-automation-rule-webhook-001

{
  "name": "Send churn risk webhook",
  "description": "Notifies an external system about churn risk feedback.",
  "triggerEventType": "feedback.ai-analysis-completed",
  "conditionJson": {
    "sentiment": "NEGATIVE",
    "riskLevel": "CHURN_RISK"
  },
  "actionJson": [
    {
      "type": "WEBHOOK",
      "url": "https://example.com/webhooks/feedback",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "replace-me"
      },
      "body": {
        "eventId": "{{event.eventId}}",
        "feedbackId": "{{event.aggregateId}}",
        "sentiment": "{{payload.sentiment}}",
        "riskLevel": "{{payload.riskLevel}}"
      },
      "timeoutMs": 5000
    }
  ],
  "priority": 100
}

### Create automation rule with default priority
POST {{baseUrl}}/api/v1/automation/rules
Content-Type: application/json
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-create-automation-rule-default-priority-001

{
  "name": "Log any completed AI analysis",
  "triggerEventType": "feedback.ai-analysis-completed",
  "conditionJson": {
    "status": "NEW"
  },
  "actionJson": [
    {
      "type": "LOG",
      "message": "AI analysis completed"
    }
  ]
}

### List automation rules
GET {{baseUrl}}/api/v1/automation/rules?page=0&size=20
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-list-automation-rules-001

### Get automation rule by id
GET {{baseUrl}}/api/v1/automation/rules/{{ruleId}}
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-get-automation-rule-001

### Update automation rule
PATCH {{baseUrl}}/api/v1/automation/rules/{{ruleId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-update-automation-rule-001

{
  "name": "Updated churn risk rule",
  "description": "Updated description",
  "triggerEventType": "feedback.ai-analysis-completed",
  "conditionJson": {
    "sentiment": "NEGATIVE",
    "riskLevel": "CHURN_RISK"
  },
  "actionJson": [
    {
      "type": "LOG",
      "message": "Updated churn risk feedback message"
    }
  ],
  "priority": 200
}

### Activate automation rule
POST {{baseUrl}}/api/v1/automation/rules/{{ruleId}}/activate
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-activate-automation-rule-001

### Deactivate automation rule
POST {{baseUrl}}/api/v1/automation/rules/{{ruleId}}/deactivate
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-deactivate-automation-rule-001

### List automation executions
GET {{baseUrl}}/api/v1/automation/executions?page=0&size=20
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-list-automation-executions-001

### Get automation execution by id
GET {{baseUrl}}/api/v1/automation/executions/{{executionId}}
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-get-automation-execution-001

### List automation action executions
GET {{baseUrl}}/api/v1/automation/executions/{{executionId}}/actions
Authorization: Bearer {{accessToken}}
X-Tenant-Slug: {{tenantSlug}}
X-Correlation-Id: demo-list-automation-action-executions-001

### Missing tenant header
GET {{baseUrl}}/api/v1/automation/rules?page=0&size=20
Authorization: Bearer {{accessToken}}
X-Correlation-Id: demo-list-automation-rules-missing-tenant-001
